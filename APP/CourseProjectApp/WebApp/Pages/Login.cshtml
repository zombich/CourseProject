@page
@model WebApp.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<main class="auth-main">
    <section class="surface-card auth-card">
        <h1 id="login-heading" class="auth-title">Вход в аккаунт</h1>
        <p class="auth-subtitle">Продолжайте разбирать тексты вместе с сообществом</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert" style="margin-bottom: 16px;">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label asp-for="Username" class="form-label">Логин</label>
                <input asp-for="Username"
                       id="login-username"
                       type="text"
                       class="form-input"
                       placeholder="Введите логин"
                       autocomplete="username"
                       required />
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Пароль</label>
                <input asp-for="Password"
                       id="login-password"
                       type="password"
                       class="form-input"
                       placeholder="Введите пароль"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary btn-lg auth-submit">Войти</button>
        </form>

        <p class="auth-footer-note">
            Впервые на сайте? <a asp-page="/Register">Создать аккаунт</a>
        </p>
    </section>
</main>
