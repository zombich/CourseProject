<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — МеждуСтрок</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <div class="header-left">
                <a asp-page="/Index" class="brand-logo">
                    <span>
                        <img src="~/icons/site_icon.svg" width="64" height="64" alt="МеждуСтрок" />
                    </span>
                    <span>МеждуСтрок</span>
                </a>

                <nav class="header-nav">
                    <a asp-page="/Index" class="nav-link">
                        <img src="~/icons/music.svg" width="24" height="24" alt="" />
                        <span>Главная</span>
                    </a>
                    <a asp-page="/Search" class="nav-link">
                        <img src="~/icons/search.svg" width="24" height="24" alt="" />
                        <span>Поиск</span>
                    </a>
                    @if (User.IsInRole("Модератор") || User.IsInRole("Администратор") || User.IsInRole("Артист"))
                    {
                        <a asp-page="/Manage" class="nav-link">
                            <img src="~/icons/album.svg" width="24" height="24" alt="" />
                            <span>Студия</span>
                        </a>
                    }
                </nav>
            </div>

            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Profile" class="btn btn-ghost">
                        <img src="~/icons/user_circle.svg" width="20" height="20" alt="" />
                        <span>@User.Identity.Name</span>
                    </a>
                    <form asp-page="/Logout" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-outline">
                            <img src="~/icons/logoff.svg" width="18" height="18" alt="" />
                            <span>Выйти</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-page="/Register" class="btn btn-ghost">Регистрация</a>
                    <a asp-page="/Login" class="btn btn-primary" data-nav="login">Вход</a>
                }
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <a asp-page="/Index" class="brand-logo">
                        <span>МеждуСтрок</span>
                    </a>
                    <p class="footer-tagline">Сообщество для разбора текстов песен</p>
                </div>

                <nav class="footer-links">
                    <a asp-page="/Index" class="footer-link">Главная</a>
                    <a asp-page="/Search" class="footer-link">Поиск</a>
                    <a asp-page="/RandomTrack" class="footer-link">Случайный трек</a>
                    <a asp-page="/Profile" class="footer-link">Профиль</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-page="/Login" class="footer-link">Вход</a>
                    }
                </nav>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
